# Copy this file to .env and fill in real values. Never commit .env itself.

# Optional. If set, the AI Investigation Assistant (backend/app/investigation_assistant.py)
# uses the Claude API to write a more natural case narrative for analysts.
# If unset, it automatically falls back to a deterministic, rule-based
# narrative (see template_explain() in the same file) -- the dashboard
# works fully either way.
ANTHROPIC_API_KEY=

# Optional. Port the Flask API + dashboard are served on.
PORT=5000
